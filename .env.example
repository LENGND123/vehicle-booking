# MongoDB connection string (MongoDB Atlas -> Connect -> Drivers).
# Leave empty during local development to use a built-in local database stored in .data/
MONGODB_URI=

# Any long random string. Used to sign login cookies.
JWT_SECRET=change-me-to-a-long-random-string

# Whoever registers with this email becomes the admin.
ADMIN_EMAIL=admin@example.com

# ZEGOCLOUD console -> your project -> App ID and ServerSecret (32 characters).
# Needed only for the Video KYC call.
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=
